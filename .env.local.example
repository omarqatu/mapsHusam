# إعدادات البيئة المحلية (Development)
# انسخ هذا الملف إلى .env.local واستخدمه للعمل المحلي

# إعدادات السيرفر
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=1

# إعدادات قاعدة البيانات
POSTGRES_HOST=144.91.84.168
POSTGRES_PORT=5432
POSTGRES_USER=Husam
POSTGRES_PASSWORD=Husam
SERVICES_DB_NAME=services_db
REAL_ESTATE_DB_NAME=realestate

# إعدادات GeoServer
GEOSERVER_TARGET=http://194.163.174.162:8080/geoserver
GEOSERVER_USER=your_geoserver_user
GEOSERVER_PASSWORD=your_geoserver_password

# إعدادات CORS (للتطوير المحلي)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_ALL_ORIGINS=true

# إعدادات الأمان
SESSION_SECRET=dev_secret_key_change_this_in_production
JWT_SECRET=dev_jwt_secret_change_this_in_production

# Rate Limiting
API_RATE_LIMIT=100
API_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=5
SOCKET_RATE_LIMIT=10

# Security Headers
ENABLE_HELMET=false
ENABLE_CORS=true
ENABLE_RATE_LIMITING=false

# File Upload Security
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.pdf
