# إعدادات البيئة المحلية (Development)
# انسخ هذا الملف إلى .env.local واستخدمه للعمل المحلي

# إعدادات السيرفر
PORT=3000
HOST=0.0.0.0
TRUST_PROXY_HOPS=1
STATIC_ALLOWLIST_MODE=enforce

# إعدادات قاعدة البيانات
POSTGRES_HOST=your_db_host
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
SERVICES_DB_NAME=services_db
REAL_ESTATE_DB_NAME=realestate

# إعدادات GeoServer
GEOSERVER_TARGET=http://your_geoserver_host:8080/geoserver
GEOSERVER_USER=your_geoserver_user
GEOSERVER_PASSWORD=your_geoserver_password

# إعدادات CORS (للتطوير المحلي)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_ALL_ORIGINS=true

# إعدادات الأمان
SESSION_SECRET=generate_a_unique_random_secret_for_this_environment
JWT_SECRET=generate_a_unique_random_secret_at_least_32_characters

# Rate Limiting
API_RATE_LIMIT=100
API_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=5
SOCKET_RATE_LIMIT=10

# Security Headers
ENABLE_HELMET=false
ENABLE_CORS=true
ENABLE_RATE_LIMITING=false

# File Upload Security
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.pdf
