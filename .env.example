# إعدادات السيرفر
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1

# إعدادات قاعدة البيانات
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
SERVICES_DB_NAME=services_db
REAL_ESTATE_DB_NAME=realestate

# إعدادات GeoServer
GEOSERVER_TARGET=http://194.163.174.162:8080/geoserver
GEOSERVER_USER=your_geoserver_user
GEOSERVER_PASSWORD=your_geoserver_password

# إعدادات CORS (اختياري - للسماح بمصادر إضافية)
ALLOWED_ORIGINS=https://psm.alameenapps.com,http://194.163.174.162:3000
ALLOW_ALL_ORIGINS=false

# إعدادات الأمان
SESSION_SECRET=your_super_secret_session_key_change_this_in_production
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Rate Limiting
API_RATE_LIMIT=100
API_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=5
SOCKET_RATE_LIMIT=10

# Security Headers
ENABLE_HELMET=true
ENABLE_CORS=true
ENABLE_RATE_LIMITING=true

# File Upload Security
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.pdf
