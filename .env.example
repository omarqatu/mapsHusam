# انسخ هالملف باسم .env بجذر المشروع (على السيرفر) وحط القيم الحقيقية.
# .env مستثنى من git والنشر ما بيلمسه. لا تحط قيم حقيقية بهالملف — المستودع عام.
# السيرفر بيقرأ .env بس (مش .env.local).

# --- مطلوب ---
POSTGRES_HOST=your_db_host
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
# عنوان GeoServer اللي بيمرّر له السيرفر طلبات /geoserver-proxy
GEOSERVER_TARGET=http://your_geoserver_host:8080/geoserver
# سر توقيع الجلسات: نص عشوائي طويل (32 حرف أو أكثر). تغييره بيطلّع كل المستخدمين مرة وحدة.
JWT_SECRET=generate_a_long_random_secret

# --- اختياري (القيمة الافتراضية بين القوسين) ---
POSTGRES_PORT=5432
SERVICES_DB_NAME=services_db
REAL_ESTATE_DB_NAME=realestate
NODE_ENV=production
PORT=3000
# عدد الوسطاء أمام Node (IIS = 1)
TRUST_PROXY_HOPS=1
# الدومينات المسموح لها تتصل (مفصولة بفواصل). فاضي = أي دومين — اضبطه بالإنتاج
ALLOWED_ORIGINS=https://psm.alameenapps.com
# عمر جلسة الدخول بالأيام (30)
SESSION_TTL_DAYS=30
# أقصى اتصالات لكل قاعدة (25)
PG_POOL_MAX=25

# حدود الطلبات — false بيطفيها (مش منصوح)
ENABLE_RATE_LIMITING=true
API_RATE_LIMIT=1000
API_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=10
SOCKET_RATE_LIMIT=20
# محاولات دخول فاشلة قبل القفل (10)
LOGIN_MAX_FAILS=10
# ترويسات الأمان — false بيطفيها (مش منصوح)
ENABLE_HELMET=true

# off = السيرفر ما بيقدّم الواجهة (web/dist) — للتطوير بس
SERVE_REACT_APP=auto
# 1 = سجلات مفصّلة لكل طلب
DEBUG_LOGS=0
