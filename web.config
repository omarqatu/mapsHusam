<?xml version="1.0" encoding="UTF-8"?>
<configuration>
 <!-- Test -->
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 0. توجيه Socket.io إلى Node (أولوية قصوى - قبل كل شيء) -->
        <rule name="SocketIO" stopProcessing="true">
          <match url="^socket.io/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/socket.io/{R:1}" />
        </rule>
        <!-- 1. توجيه بروكسي GeoServer إلى Node (قبل قاعدة الملفات الثابتة) -->
        <rule name="GeoServer Proxy" stopProcessing="true">
          <match url="^geoserver-proxy/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/geoserver-proxy/{R:1}" />
        </rule>
        <!-- 2. توجيه مسارات الـ API إلى Node -->
        <rule name="API Routes" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/api/{R:1}" />
        </rule>
        <!-- حجب ملفات المصدر والأسرار ومجلدات التطوير قبل قاعدة الملفات الثابتة -->
        <rule name="Block Repository and Secret Files" stopProcessing="true">
          <match url="^(?:server\.js|package(?:-lock)?\.json|SECURITY\.md|README\.md|STARTUP\.md|(?:.*\/)?\.env(?:\..*)?|node_modules(?:/.*)?|database(?:/.*)?|docs(?:/.*)?|tools(?:/.*)?|dist(?:/.*)?|\.git(?:/.*)?|.*\.(?:bak|old|orig|sql|log|pem|key|sh|bat|ps1))$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <!-- 2.5 توجيه مسار تسجيل الإحصائيات إلى Node -->
        <rule name="Save Stat Route" stopProcessing="true">
          <match url="^save-stat" />
          <action type="Rewrite" url="http://127.0.0.1:3000/save-stat" />
        </rule>
        <!-- 3. كل ما عدا ما سبق (تطبيق React: الصفحات والملفات المبنية) يقدّمه Node من web/dist.
             لم تعد ملفات الموقع على قرص IIS: البناء يتم داخل web على الخادم ويقرؤه Node. -->
        <rule name="App via Node" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:0}" />
        </rule>
      </rules>
    </rewrite>
    <!-- تمرير أخطاء Node/GeoServer كما هي (JSON) بدل استبدالها بصفحات IIS -->
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <requestLimits maxUrl="8192" maxQueryString="8192" maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
