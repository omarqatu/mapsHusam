# Local-only development environment for server.js (NOT production values).
# dotenv never overrides variables that are already set, so sourcing this file wins over the
# repo's real .env without touching it.
NODE_ENV=development
PORT=3000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=psm
POSTGRES_PASSWORD=psm_dev_only
SERVICES_DB_NAME=services_db
REAL_ESTATE_DB_NAME=realestate
JWT_SECRET=dev-only-jwt-secret-0123456789abcdef0123456789abcdef
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Deliberately NOT the production GeoServer (WFS-T from the editor can write). Map phases will
# need a real/local GeoServer — see dev/README.md.
GEOSERVER_TARGET=${GEOSERVER_TARGET:-http://127.0.0.1:8080/geoserver}
AUTH_RATE_LIMIT=1000
LOGIN_MAX_FAILS=50
STATIC_ALLOWLIST_MODE=report
